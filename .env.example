# WebQuake configuration.
#
# Copy to .env and fill in, or export these in your process manager / service
# unit. Nothing here has a working default: required variables abort startup
# when unset, and optional ones simply disable the feature they belong to.

# --- Required -----------------------------------------------------------------

# Flask session signing key. Must stay the same across restarts and across
# every worker, or logged-in admin sessions break. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBQUAKE_SECRET_KEY=

# DM-DSS (DMDATA) credentials. WebQuake reads JMA telegrams from DMDATA, which
# is a PAID subscription — the server cannot run without one.
# Create an OAuth application at https://dmdata.jp/ to get the client pair,
# then use private/get_refresh.py to obtain a refresh token for it.
WEBQUAKE_DMDATA_CLIENT_ID=
WEBQUAKE_DMDATA_CLIENT_SECRET=
WEBQUAKE_DMDATA_REFRESH_TOKEN=

# --- Optional -----------------------------------------------------------------

# Public URL of this deployment. Used for notification click-through links.
# Leave empty to send notifications without a link.
WEBQUAKE_SITE_URL=

# Admin panel. Leave empty to disable it entirely — every /admin and
# /api/admin route then returns 404. Use a long random value if you set it.
WEBQUAKE_ADMIN_PASSWORD=

# OneSignal hosted web push. Both must be set for push to be sent.
# The app ID is public and must also be set in public/index.html; the REST
# API key is a secret and belongs only here.
WEBQUAKE_ONESIGNAL_APP_ID=
WEBQUAKE_ONESIGNAL_REST_API_KEY=

# ntfy (self-hosted push). Notifications are skipped unless the server URL,
# the token, and the relevant topic are all set. Choose your own topic names —
# do not reuse the ones from the upstream deployment.
# The token is a publish-only access token created on your ntfy server.
# Topic names must also be set in public/app.js for the subscribe UI.
WEBQUAKE_NTFY_URL=
WEBQUAKE_NTFY_TOKEN=
WEBQUAKE_NTFY_ICON_URL=
WEBQUAKE_NTFY_TOPIC_ALERTS_EN=
WEBQUAKE_NTFY_TOPIC_ALERTS_JA=
WEBQUAKE_NTFY_TOPIC_FORECASTS_EN=
WEBQUAKE_NTFY_TOPIC_FORECASTS_JA=

# Discord webhooks, one per language. Each is skipped if unset.
WEBQUAKE_DISCORD_WEBHOOK_EN=
WEBQUAKE_DISCORD_WEBHOOK_JA=

# Discord bot token, used only to crosspost webhook messages in announcement
# channels so following servers receive them. Needs Manage Messages only.
WEBQUAKE_DISCORD_BOT_TOKEN=
